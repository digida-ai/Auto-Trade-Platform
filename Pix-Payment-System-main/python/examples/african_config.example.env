# Example configuration for African payment providers (per market/provider).
# Copy/adapt per environment; do not commit real secrets.

# Generic gateway (works with any configured provider/aggregator)
PAYMENT_API_BASE_URL=https://api.sandbox.provider.example
PAYMENT_API_KEY=your-api-key

# MTN MoMo (example)
MOMO_API_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_API_KEY=your-momo-api-key
MOMO_SUBSCRIPTION_KEY=your-subscription-key

# M-Pesa (example - Daraja or aggregator)
MPESA_API_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey

# Common fields
PAYMENT_CALLBACK_URL=https://merchant.example/webhooks/payment
DEFAULT_COUNTRY=KE
DEFAULT_CURRENCY=KES
