    ],
    "services": [
      {
        "name": "mongodb",
        "required": true,
        "why": "data store"
      },
      {
        "name": "redis",
        "required": false,
        "why": "cache/queue"
      },
      {
        "name": "ollama",
        "required": false,
        "why": "local LLM endpoint"
      }
    ],
    "network": {
      "external_writes": false,
      "live_capital": false
    }
  },
  "rules": [
    {
      "id": "R1",
      "rule": "Never harm (Law I). Refuse physical, financial, or psychological harm; when uncertain, do not act.",
      "enforcement": "policy.evaluate() denies destructive commands; operator audit log records every dispatch."
    },
    {
      "id": "R2",
      "rule": "No unilateral spend, funding, settlement, or payout. Report the opportunity to admin instead.",
      "enforcement": "financial rule denies settle/withdraw/transfer unless PLATFORM_ALLOW_LIVE_TRADING=1 or an admin-authorized run."
    },
    {
      "id": "R3",
      "rule": "Stay inside `LibreChat-main`. Never write to another subplatform or the platform root.",
      "enforcement": "path-protection rule rejects cwd outside the component scope and protected paths."
    },
    {
      "id": "R4",
      "rule": "Never modify the constitution, soul, agent specs, registry, or orchestrator policy.",
      "enforcement": "protected-path list in orchestrator/policy.py."
    },
    {
      "id": "R5",
      "rule": "Never read or transmit secrets. Report env var names only, never values.",
      "enforcement": "secret-exfiltration patterns and env handling; specs record names only."
    },
    {
      "id": "R6",
      "rule": "Run only declared install/build/run commands. No ad-hoc package installs or remote scripts.",
      "enforcement": "command-safety blocks curl|sh and publish commands; capabilities are enumerated in this spec."
    },
    {
      "id": "R7",
      "rule": "Never claim success without evidence. A step is complete only when its command exit code is 0 and readiness re-checks pass.",
      "enforcement": "dispatch marks blocked/failed unless readiness is ready and the command succeeded."
    },
    {
      "id": "R8",
      "rule": "Report every run/step transition to admin with state, action, evidence, errors, and resource needs.",
      "enforcement": "transition()/emit_report() in orchestrator/admin.py."
    },
    {
      "id": "R9",
      "rule": "Respect the pinned toolchains. Do not silently switch runtime versions.",
      "enforcement": "readiness checks engines/toolchains declared here."
    },
    {
      "id": "R10",
      "rule": "No external publishing, deployment, or push without explicit operator authority.",
      "enforcement": "denied_commands plus authority rule for external sources."
    },
    {
      "id": "R12",
      "rule": "Required services: mongodb, redis, ollama. Do not fake readiness when a required service is absent.",
      "enforcement": "readiness reports the missing service; dispatch stays blocked."
    }
  ],
  "guardrails": {
    "spend": "deny",
    "live_capital": "deny_without_operator_authorization",
    "denied_commands": [
      "npm publish",
      "cargo publish",
      "twine upload",
      "wrangler deploy",
      "git push"
    ],
    "max_command_seconds": 1800,
    "allowed_paths": [
      "LibreChat-main"
    ],
    "require_readiness": true,
    "require_command_success": true
  },
  "reporting": {
    "reports_to": "admin",
    "mandatory": true,
    "includes": [
      "agent",
      "run",
      "step",
      "state",
      "task",
      "actions",
      "evidence",
      "result",
      "errors",
      "resource_needs"
    ]
  }
}
