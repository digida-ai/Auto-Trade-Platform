{
  "name": "autotrading-ideal-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AutoTrading Ideal Platform - unified orchestrator for all bundled subplatforms",
  "workspaces": [
    "agentic-inbox-main",
    "agent-desktop-main/npm",
    "freellmapi-main",
    "freellmapi-main/shared",
    "freellmapi-main/server",
    "freellmapi-main/client",
    "freellmapi-main/cli",
    "freellmapi-main/desktop",
    "hyperframes-main",
    "hyperframes-main/packages/*",
    "LibreChat-main",
    "LibreChat-main/api",
    "LibreChat-main/client",
    "LibreChat-main/packages/*",
    "LibreChat-main/vendor/code",
    "Open-Higgsfield-AI-main"
  ],
  "scripts": {
    "start": "node scripts/start-platform.js",
    "init": "node scripts/init-platform.js",
    "agents": "node scripts/generate-agents.js",
    "orchestrator": "python -m orchestrator",
    "check": "python -m compileall -q orchestrator"
  },
  "engines": {
    "node": ">=18"
  }
}
